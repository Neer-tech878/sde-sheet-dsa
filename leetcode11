//brute force
// for loop and inner for loop leading - O(n^2)
class Solution {
    public int maxArea(int[] height) {
        //height arr height[] = [1 3 0 5 3 1]
        int n = height.length;
        int max = 0;
        for(int i=0;i<n;i++){
            for(int j = i+1;j<n;j++){
                int l = j - i;
                int h = Math.min(height[i],height[j]);
                int area = l * h;
                max = Math.max(area,max);
            }
        }
        return max;
    }
}
O(n^2) - waste or T.L.E for these constraints : 2 <= n <= 105
//2-pointer optimal approach
// Moving pointers to each other use **while loop**
class Solution {
    public int maxArea(int[] height) {
        //height arr height[] = [1 3 0 5 3 1]
        int max = 0;
        int left = 0;
        int right = height.length - 1;
        while(left<right){
            int h = Math.min(height[left],height[right]);
            int l = right - left;
            int area = h * l;
            max = Math.max(area,max);
        while(left<right && height[left]<=h){left++;}     //can use if too but it gonna checks through every height but here it gonna skip which height are lesser than prevoius where water overflow no need to check goes to next height value
        while(left<right && height[right]<=h){right--;}
    }
        return max;
    }
}
